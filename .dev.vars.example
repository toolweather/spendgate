# Receiving wallet for x402 USDC on Base mainnet.
# Leave empty until you have an address you control. Do not commit .dev.vars.
PAY_TO=

# Same value as the Toolweather Worker's BUNDLE_PROXY_SECRET.
# Set the deployed secret with: npx wrangler secret put BUNDLE_PROXY_SECRET
# Do not commit the value.
BUNDLE_PROXY_SECRET=

# Optional. Defaults to https://paycheck.toolweather.workers.dev.
# PAYCHECK_URL=
# Optional pc_live_ key. Unset uses BUNDLE_PROXY_SECRET, then anonymous PayCheck.
# PAYCHECK_API_KEY=
