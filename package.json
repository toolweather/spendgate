{
  "name": "spendgate",
  "version": "1.0.0",
  "private": true,
  "description": "Decision API and MCP server that scores a planned spend before an agent pays.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --port 43123 --ip 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:stdio": "tsc -p tsconfig.stdio.json",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply spendgate --local",
    "db:migrate:remote": "wrangler d1 migrations apply spendgate --remote"
  },
  "dependencies": {
    "hono": "^4.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
